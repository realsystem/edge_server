# Edge Server Bootstrap Configuration
# Copy to bootstrap.cfg and customize

[target]
# SSH connection settings
SSH_TIMEOUT = 10
SSH_RETRIES = 3
# SSH_KEY_FILE = ~/.ssh/deploy
# SSH_STRICT_HOST_KEY_CHECKING = accept-new

[logging]
# Log directory (default: ~/.edge-server/logs)
# LOG_DIR = /var/log/edge_server

[timeouts]
# Per-phase timeouts in seconds
DISCOVERY = 30
PREREQUISITES = 60
INITIAL_SETUP = 300
REBOOT_WAIT = 120
SECRETS = 60
DEPLOYMENT_BASE = 600
DEPLOYMENT_SECURITY = 900
VERIFICATION = 120

# Probe settings for health checks
PROBE_INTERVAL = 5
PROBE_COUNT = 3

[network]
# Default network configuration
DEFAULT_DNS = 8.8.8.8
DEFAULT_GATEWAY =

[services]
# Service verification after deployment
VERIFY_TAILSCALE = true
VERIFY_HOMEASSISTANT = true
VERIFY_MQTT = true
VERIFY_FRIGATE = true

# Service ports
HA_PORT = 8123
MQTT_PORT = 1883
FRIGATE_PORT = 5000

[rollback]
# Automatic rollback on failure
ENABLED = true
SNAPSHOT_BEFORE_DEPLOY = true
RESTORE_ON_FAILURE = true
SNAPSHOT_DIR = /var/lib/edge-server-snapshots
