# Farm Edge Server Environment Variables
# Copy to .env and fill in values before running deploy-edge-server.sh
# Or export these before running the script

# Tailscale auth key (generate at https://login.tailscale.com/admin/settings/keys)
# Use a reusable key for easier re-provisioning
TAILSCALE_AUTH_KEY=

# External storage UUID for Frigate video retention
# Find with: lsblk -o NAME,UUID,SIZE,MOUNTPOINT
EXTERNAL_DRIVE_UUID=

# Local subnet for firewall rules (CIDR notation)
LOCAL_SUBNET=192.168.0.0/16

# Timezone
TIMEZONE=America/Los_Angeles

# MQTT credentials (will be auto-generated if not set)
MQTT_USER=farmuser
MQTT_PASS=
