# macOS Local Testing Environment
# Used with docker-compose.mac.yml

TZ=America/Los_Angeles

# Local mock storage (relative to testing directory)
STORAGE_PATH=./mock_storage

# RTSP streams point to mock camera harness via host.docker.internal
RTSP_HOST=host.docker.internal

# Mock camera credentials (not used for test streams, but needed by config)
REOLINK_USER=admin
REOLINK_PASS=testpassword

# Camera stream URLs (pointing to local mock RTSP server)
CAM1_MAIN=rtsp://host.docker.internal:8554/cam1_front
CAM1_SUB=rtsp://host.docker.internal:8554/cam1_front_sub
CAM2_MAIN=rtsp://host.docker.internal:8554/cam2_rear
CAM2_SUB=rtsp://host.docker.internal:8554/cam2_rear_sub
CAM3_MAIN=rtsp://host.docker.internal:8554/cam3_side
CAM3_SUB=rtsp://host.docker.internal:8554/cam3_side_sub
CAM4_MAIN=rtsp://host.docker.internal:8554/cam4_gate
CAM4_SUB=rtsp://host.docker.internal:8554/cam4_gate_sub
